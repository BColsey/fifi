# Generated files belong in task scratch; ignores do not limit disk usage.
target/
/target-*/
/engine/target-*/
/.worktrees/
/tmp/
/models/
/weights/
/downloads/
*.nsys-rep
*.qdrep
*.ncu-rep
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/

# Keep shared Claude settings and commands visible; ignore local runtime state.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
.claude/routines/.state/
.claude/worktrees/
.claude/checkpoints/
.claude/mailbox/
.claude/agent-registry.json
.claude/agent-memory-local
.claude/first-run
.claude/assistant-daemon-state.json

.env
*.log
.DS_Store
*.swp
*.swo
__pycache__/
*.py[cod]

# Host instructions stay local; shared AGENTS.md and CLAUDE.md are tracked.
/AGENTS.local.md

# The ledger and process documents live in the internal ledger.
/WORK_LOG.md
/docs/
/specs/
/research/
/CONVENTIONS.md
/PLAN.md
/qualification/*
# The token-forcing device drivers are tracked in place; the rest of qualification/ is
# internal and force-added file by file.
!/qualification/token-forcing/
# The MTP acceptance collector is tracked in place as well.
!/qualification/mtp-acceptance/
.pi-dsh/
.pi-glla/
engine/.pi-dsh/
.pi/
