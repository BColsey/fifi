#!/bin/sh
set -eu

if ! command -v python3 >/dev/null 2>&1; then
    printf '%s\n' 'pre-commit: required tool python3 was not found on PATH' >&2
    exit 127
fi

# Fail closed: a missing check script must block, never silently pass.
for script in scripts/check_staged.py scripts/check_doc_links.py; do
    if [ ! -f "$script" ]; then
        printf '%s\n' "pre-commit: $script is missing; run from a checkout that tracks scripts/" >&2
        exit 1
    fi
done
python3 scripts/check_staged.py pre-commit
exec python3 scripts/check_doc_links.py
